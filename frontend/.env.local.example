# OpenTripPlanner 2 (local Docker backend)
VITE_OTP_URL=http://localhost:8080

# Departure time for route calculations (HH:MM:SS, next Monday in Madrid timezone)
VITE_OTP_DEPARTURE_TIME=09:00:00

# Transit modes for point-to-point routing (TRANSIT is broken in OTP2 v1 REST API)
VITE_OTP_TRANSIT_MODES=WALK,SUBWAY,BUS,TRAM,RAIL

# Number of transit route alternatives to evaluate (pick the fastest)
VITE_OTP_TRANSIT_ITINERARIES=3

# Anthropic API key for screenshot parsing (vision)
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-haiku-4-5

# Scoring: travel sub-index weights (walk / public transport / cycling / driving)
VITE_WEIGHT_WALK=4
VITE_WEIGHT_PT=3
VITE_WEIGHT_CYCLE=2
VITE_WEIGHT_CAR=1

# Scoring: travel time cap in minutes (beyond this = score 0 for that mode)
VITE_TRAVEL_CAP_MINUTES=60

# Scoring: composite score weights (travel index vs noise score)
VITE_COMPOSITE_WEIGHT_TRAVEL=5
VITE_COMPOSITE_WEIGHT_NOISE=2

# TMB (Transports Metropolitans de Barcelona) — metro lines & stations
# Get credentials at https://developer.tmb.cat
VITE_TMB_APP_ID=
VITE_TMB_APP_KEY=
