# OpenTripPlanner 2 (local Docker backend)
VITE_OTP_URL=http://localhost:8080

# Departure time for route calculations (HH:MM:SS, next Monday in Madrid timezone)
VITE_OTP_DEPARTURE_TIME=09:00:00

# Transit modes for point-to-point routing (TRANSIT is broken in OTP2 v1 REST API)
VITE_OTP_TRANSIT_MODES=WALK,SUBWAY,BUS,TRAM,RAIL

# Number of transit route alternatives to evaluate (pick the fastest)
VITE_OTP_TRANSIT_ITINERARIES=3

# Anthropic API key for screenshot parsing (vision)
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-haiku-4-5

# Scoring: travel sub-index weights (walk / public transport / cycling / driving)
VITE_WEIGHT_WALK=4
VITE_WEIGHT_PT=3
VITE_WEIGHT_CYCLE=2
VITE_WEIGHT_CAR=1

# Scoring: travel time cap in minutes (beyond this = score 0 for that mode)
VITE_TRAVEL_CAP_MINUTES=60

# Scoring: composite score weights (travel index vs noise score)
VITE_COMPOSITE_WEIGHT_TRAVEL=5
VITE_COMPOSITE_WEIGHT_NOISE=2

# TMB (Transports Metropolitans de Barcelona) — metro lines & stations
# Get credentials at https://developer.tmb.cat
VITE_TMB_APP_ID=
VITE_TMB_APP_KEY=

# Idealista export: effective area is split into simple hole-free polygons (one link each),
# because Idealista's `shape` accepts only a single hole-free polygon per search.
VITE_IDEALISTA_MAX_AREAS=16         # cap on the number of exported areas (biggest first)
VITE_IDEALISTA_MIN_AREA_KM2=0.05    # absolute floor: drop pieces smaller than this (keeps real islands)
VITE_IDEALISTA_AREA_RATIO=0         # optional relative floor (fraction of largest piece); 0 = off
VITE_IDEALISTA_HOLE_MIN_KM2=0.1     # only cut the area open around holes ≥ this (exclusions); fill smaller ones
VITE_IDEALISTA_SIMPLIFY_TOL=0.0004  # initial ring simplification tolerance (degrees)
VITE_IDEALISTA_MAX_URL_CHARS=900    # simplify each piece until its search URL fits (Idealista 400s on over-long shapes)
VITE_IDEALISTA_MERGE_GAP_DEG=0.0005 # buffer expand+shrink to merge nearby island pieces and fill gaps between barris (0 = off); ~55 m default
VITE_IDEALISTA_MIN_BBOX_DIM_DEG=0.0003 # drop sub-polygons whose bounding box smallest side < this (removes thin sliver artefacts at isochrone boundary); ~33 m default
