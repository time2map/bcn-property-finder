# Production build config — public, committed. Loaded by `vite build`.
# ONLY publicly-safe values belong here. NO secret keys (e.g. VITE_ANTHROPIC_API_KEY).
# Client keys that must reach the browser (e.g. TMB metro) are injected from CI secrets in
# .github/workflows/deploy.yml, so they stay out of the repo.

# Client keys injected from CI secrets (deploy.yml): VITE_TMB_APP_ID/KEY, VITE_GEOAPIFY_API_KEY (restrict it by HTTP referrer).

# Feature flags (see docs/FEATURE_FLAGS.md)
VITE_FEATURE_ISOCHRONE=false
VITE_FEATURE_EXCLUSIONS=false
VITE_FEATURE_PINS=false
VITE_FEATURE_IDEALISTA_PRICES=false
VITE_FEATURE_SCREENSHOT=false
VITE_FEATURE_BEST_ZONES=false
VITE_FEATURE_LOCALS_OPINION=true

# Composite score weights. Public livability = noise + walkability (workplace-independent);
# travel is isochrone-gated and off in public. Pinned here so scores are deterministic in CI.
VITE_COMPOSITE_WEIGHT_TRAVEL=5
VITE_COMPOSITE_WEIGHT_NOISE=2
VITE_COMPOSITE_WEIGHT_WALKABILITY=3

# Climate-risk penalties (feature TODO-036) — see .env.local.example for the formula.
VITE_FLOOD_PENALTY_T10=1
VITE_FLOOD_PENALTY_T100=0.27
VITE_FLOOD_PENALTY_T500=0.06
VITE_RISK_STRENGTH_FLOOD=5
VITE_RISK_STRENGTH_FIRE=5
VITE_RISK_STRENGTH_STREET=5
VITE_STREET_FLOOD_MIN_CM=10
VITE_STREET_FLOOD_MAX_CM=50
VITE_COND_NOISE_MAX_DB=65
VITE_COND_PRICE_MAX_EUR_M2=4000
VITE_COND_CITY_CORE_MAX_MIN=30
VITE_COND_WALK_MAX_MIN=10
VITE_COND_LOCALS_MIN=7.5
VITE_COND_NOISE_FALLOFF_DB=10
VITE_COND_PRICE_FALLOFF_PCT=25
VITE_COND_MINUTES_FALLOFF_FACTOR=2
VITE_COND_SATISF_FALLOFF=1
# Score model audit (TODO-073)
VITE_WALK_DEFAULT_CATEGORIES=supermarket,pharmacy,park,school,kindergarten,clinic,metro,cafe,restaurant
VITE_CITY_CORE_DEFAULT_LANDMARKS=placa_cat,barri_gotic,pg_gracia
VITE_BUDGET_HARD=true
VITE_AGE_ERA_BOUNDS=1900,1940,1980,2007
VITE_AGE_ERA_BLUR_YEARS=5
VITE_AGE_UNCERTAIN_YEAR=1900
VITE_FEATURE_FACADE_PHOTO=false
VITE_FEATURE_ONBOARDING=true
VITE_FEATURE_AREAS=true
VITE_FEATURE_ONE_BUILDING=true
VITE_MATCH_BANDS=85,65,40
# Rank awards (TODO-070): the building card and the share picture say "Top N%" of the homes in the barri / the city,
# for the narrowest tier N (percent of homes, comma-separated) the building fits in. Each scope is judged alone; outside
# every tier the line is not shown. Homes with the same score count against the building.
VITE_RANK_TIERS=10,20

# Search box (TODO-044)
VITE_SEARCH_MIN_CHARS=3
VITE_SEARCH_DEBOUNCE_MS=300
VITE_SEARCH_MAX_RESULTS=5
VITE_SEARCH_ADDRESS_ZOOM=17

# Sentence editor and onboarding (TODO-031)
VITE_QUIZ_NOISE_OPTIONS=50,58,65
VITE_QUIZ_WALK_OPTIONS=5,10,15
VITE_QUIZ_CENTRE_OPTIONS=25,30,45
VITE_QUIZ_BUDGET_OPTIONS=150000,250000,350000,500000
VITE_QUIZ_FLAT_AREA_OPTIONS=50,70,90,120
VITE_FLAT_AREA_M2=70
VITE_QUIZ_LOCALS_OPTIONS=7.0,7.5,8.0
VITE_RISK_PRESET_AVOID=5
VITE_RISK_PRESET_STRONG=8

# Ranked list of areas and the area view (TODO-051)
VITE_AREA_MIN_BUILDINGS=50
VITE_AREA_VIEW_MAX_ZOOM=13
VITE_INCOMPLETE_AREA_MIN_SHARE=0.3

# Phone layout (TODO-062)
VITE_LOCATE_NEAREST_BUILDING_M=40
VITE_TAP_TOLERANCE_PX=8
VITE_DOUBLE_TAP_GRACE_MS=280

# Share images (TODO-063): the public address printed on every image and used in link previews. A fork
# serving from github.io sets its own in the deploy workflow.
VITE_SITE_URL=https://livability.time2map.com

# Languages (TODO-065): the codes of src/locales/<code>/ that are offered in the language menu, and the one that
# is the source of the texts and the fallback. Adding a language = a folder of JSON files + its code here.
VITE_DEFAULT_LANG=en
VITE_ENABLED_LANGS=en,es,ca

# Commercial use (TODO-066): true switches off street flooding (RESCCUE) and the FGC lines until their licences are
# confirmed in writing; see docs/DATA_LICENSES.md.
VITE_COMMERCIAL_USE=false

# CTA to time2map (TODO-029): where "Want a map like this?" leads (the case-study page once it exists) and the
# utm_source it carries, so requests can be counted by source on the company site.
VITE_CTA_URL=https://time2map.com
VITE_CTA_UTM_SOURCE=livability

# "Find your one building" funnel (TODO-076, prototype behind VITE_FEATURE_ONE_BUILDING): number of steps, buildings
# aimed at after the last step, the share of the narrowing each step takes (first = strictest), smallest building
VITE_FUNNEL_STEPS=5
VITE_FUNNEL_TARGET=2
VITE_FUNNEL_STRICTNESS=3,2.5,2,1.5,1
VITE_FUNNEL_MIN_DWELLINGS=4
