# Production build config — public, committed. Loaded by `vite build`.
# ONLY publicly-safe values belong here. NO secret keys (e.g. VITE_ANTHROPIC_API_KEY).
# Client keys that must reach the browser (e.g. TMB metro) are injected from CI secrets in
# .github/workflows/deploy.yml, so they stay out of the repo.

# Feature flags — all off for public launch (see docs/FEATURE_FLAGS.md)
VITE_FEATURE_ISOCHRONE=false
VITE_FEATURE_EXCLUSIONS=false
VITE_FEATURE_PINS=false
VITE_FEATURE_IDEALISTA_PRICES=false
VITE_FEATURE_SCREENSHOT=false

# Composite score weights. Public livability = noise + walkability (workplace-independent);
# travel is isochrone-gated and off in public. Pinned here so scores are deterministic in CI.
VITE_COMPOSITE_WEIGHT_TRAVEL=5
VITE_COMPOSITE_WEIGHT_NOISE=2
VITE_COMPOSITE_WEIGHT_WALKABILITY=3

# Climate-risk penalties (feature TODO-036) — see .env.local.example for the formula.
VITE_FLOOD_PENALTY_T10=1
VITE_FLOOD_PENALTY_T100=0.6
VITE_FLOOD_PENALTY_T500=0.25
VITE_RISK_STRENGTH_FLOOD=5
VITE_RISK_STRENGTH_FIRE=5
VITE_RISK_STRENGTH_STREET=5
VITE_STREET_FLOOD_SATURATION=0.15
