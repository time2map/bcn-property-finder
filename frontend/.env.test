# Test environment. All feature flags are forced ON here so the suite exercises the full feature
# code (coverage), regardless of the public .env.local / .env.production settings. Under mode=test
# this file takes precedence over .env.local. Non-flag config (OTP URL, keys) comes from .env.local.
VITE_FEATURE_ISOCHRONE=true
VITE_FEATURE_EXCLUSIONS=true
VITE_FEATURE_PINS=true
VITE_FEATURE_IDEALISTA_PRICES=true
VITE_FEATURE_SCREENSHOT=true
