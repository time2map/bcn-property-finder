# Test environment. All feature flags are forced ON here so the suite exercises the full feature
# code (coverage), regardless of the public .env.local / .env.production settings. Under mode=test
# this file takes precedence over .env.local. Non-flag config (OTP URL, keys) comes from .env.local.
VITE_FEATURE_ISOCHRONE=true
VITE_FEATURE_EXCLUSIONS=true
VITE_FEATURE_PINS=true
VITE_FEATURE_IDEALISTA_PRICES=true
VITE_FEATURE_SCREENSHOT=true
VITE_FEATURE_BEST_ZONES=true
VITE_FEATURE_LOCALS_OPINION=true
VITE_FEATURE_FACADE_PHOTO=true
VITE_FEATURE_ONBOARDING=true
VITE_FEATURE_AREAS=true
VITE_FEATURE_ONE_BUILDING=true

# Languages (TODO-065): the codes of src/locales/<code>/ that are offered in the language menu, and the one that
# is the source of the texts and the fallback. Adding a language = a folder of JSON files + its code here.
VITE_DEFAULT_LANG=en
VITE_ENABLED_LANGS=en,es,ca

VITE_COMMERCIAL_USE=false

# CTA to time2map (TODO-029)
VITE_CTA_URL=https://time2map.com
VITE_CTA_UTM_SOURCE=livability
